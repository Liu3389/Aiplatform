# -------------------- 数据库 --------------------
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=ai_gateway
MYSQL_PORT=3307

# -------------------- Redis --------------------
REDIS_PASSWORD=redis123
REDIS_PORT=6380

# -------------------- 后端 --------------------
BACKEND_PORT=8080

# -------------------- 前端 --------------------
FRONTEND_PORT=80
BACKEND_HOST=localhost:8080

# -------------------- Cloudflare Tunnel 公网部署 --------------------
CF_TUNNEL_TOKEN=

# -------------------- 部署模式 --------------------
DEPLOY_MODE=allinone

# -------------------- 数据备份 --------------------
BACKUP_DIR=./backups
