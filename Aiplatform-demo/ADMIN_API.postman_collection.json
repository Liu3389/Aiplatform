        {
          "name": "获取系统统计数据",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "stats"]
            },
            "description": "获取系统整体统计数据，包括用户数、调用次数、收入等"
          },
          "response": []
        },
        {
          "name": "获取完整分析数据",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/analytics/full?days=7&months=6",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "analytics", "full"],
              "query": [
                {
                  "key": "days",
                  "value": "7",
                  "description": "最近N天的使用数据"
                },
                {
                  "key": "months",
                  "value": "6",
                  "description": "最近N个月的趋势数据"
                }
              ]
            },
            "description": "获取完整的分析数据，包括每日用量、模型使用、小时流量、Top用户、收入趋势、用户增长"
          },
          "response": []
        },
        {
          "name": "获取仪表盘统计数据 ⭐NEW",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/statistics/dashboard?period=7d",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "statistics", "dashboard"],
              "query": [
                {
                  "key": "period",
                  "value": "7d",
                  "description": "时间范围：7d（近7天）或 30d（近30天）"
