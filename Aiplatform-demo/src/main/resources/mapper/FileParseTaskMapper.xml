<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ai.gateway.mapper.FileParseTaskMapper">

    <select id="selectByFileIdAndUserId" resultType="com.ai.gateway.entity.FileParseTask">
        SELECT *
        FROM file_parse_task
        WHERE file_id = #{fileId}
          AND user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
