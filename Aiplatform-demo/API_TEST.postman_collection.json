{
  "info": {
    "name": "AI Gateway Platform API",
    "description": "凌点AI模型调度网关接口测试 - 使用 X-User-Token Header 认证\n\n**最新更新 (2026-05-14)**:\n- ✅ 新增会话管理（单设备登录、异地踢下线）\n- ✅ 新增对话版本控制（服务端存储）\n- ✅ 新增用户限流（60次/分钟）\n- ✅ 新增SSE断线重连支持\n- ✅ 所有请求需携带 X-Device-Id Header",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "value",
        "value": "{{token}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "X-User-Token",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "用户认证",
      "item": [
        {
          "name": "用户注册",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.code === 200) console.log('注册成功, userId=' + json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"Test@123456\",\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.code === 200 && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.collectionVariables.set('deviceId', json.data.deviceId);",
                  "  pm.collectionVariables.set('userId', json.data.userInfo.id);",
                  "  console.log('登录成功, token和deviceId已保存');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 生成或使用已有的设备ID",
                  "var deviceId = pm.collectionVariables.get('deviceId');",
                  "if (!deviceId) {",
                  "  deviceId = require('uuid').v4();",
                  "  pm.collectionVariables.set('deviceId', deviceId);",
                  "}",
                  "console.log('使用设备ID: ' + deviceId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"Test@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "查询用户信息",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/userinfo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "userinfo"]
            }
          }
        },
        {
          "name": "查询余额",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "balance"]
            }
          }
        },
        {
          "name": "刷新Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh-token"]
            }
          }
        },
        {
          "name": "退出登录",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "API Key管理",
      "item": [
        {
          "name": "生成API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.code === 200 && json.data.apiKey) {",
                  "  pm.collectionVariables.set('apiKey', json.data.apiKey);",
                  "  console.log('API Key已保存');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"我的API Key\",\n  \"rateLimit\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/api-key/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "generate"]
            }
          }
        },
        {
          "name": "查询API Key列表",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/api-key/list",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "list"]
            }
          }
        },
        {
          "name": "启用API Key",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/api-key/1/enable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "1", "enable"]
            }
          }
        },
        {
          "name": "禁用API Key",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/api-key/1/disable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "1", "disable"]
            }
          }
        },
        {
          "name": "更新限流阈值",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/api-key/1/rate-limit?rateLimit=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "1", "rate-limit"],
              "query": [{ "key": "rateLimit", "value": "200" }]
            }
          }
        },
        {
          "name": "删除API Key",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/api-key/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "模型配置",
      "item": [
        {
          "name": "模型列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/model-config/list",
              "host": ["{{baseUrl}}"],
              "path": ["api", "model-config", "list"]
            }
          }
        }
      ]
    },
    {
      "name": "会话与对话管理",
      "item": [
        {
          "name": "获取对话数据",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations"]
            }
          }
        },
        {
          "name": "保存对话数据",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversations\": [\n    {\n      \"id\": \"conv-001\",\n      \"title\": \"测试对话\",\n      \"messages\": [],\n      \"createTime\": \"2026-05-14T10:00:00\"\n    }\n  ],\n  \"version\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations"]
            }
          }
        },
        {
          "name": "检查对话版本",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversations/version?localVersion=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "version"],
              "query": [{ "key": "localVersion", "value": "0" }]
            }
          }
        },
        {
          "name": "清空对话数据（账号切换）",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversations/clear",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "clear"]
            }
          }
        },
        {
          "name": "检查会话状态",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/session/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "session", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "聊天对话",
      "item": [
        {
          "name": "免费模式 - 非流式对话",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"deepseek-v4-flash\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"你好，请介绍一下你自己\"\n  }],\n  \"mode\": \"free\",\n  \"temperature\": 0.7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "completions"]
            }
          }
        },
        {
          "name": "免费模式 - 流式对话(SSE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"deepseek-v4-flash\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"写一首关于春天的诗\"\n  }],\n  \"stream\": true,\n  \"mode\": \"free\",\n  \"temperature\": 0.8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/stream",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "stream"]
            }
          }
        },
        {
          "name": "自定义模型 - 非流式对话",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"deepseek-chat\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"你好\"\n  }],\n  \"mode\": \"custom\",\n  \"userApiKeyId\": 1,\n  \"temperature\": 0.7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "completions"]
            }
          }
        },
        {
          "name": "SSE断线重连测试",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" },
              { "key": "Last-Event-ID", "value": "{{lastEventId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"deepseek-v4-flash\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"继续之前的对话\"\n  }],\n  \"stream\": true,\n  \"mode\": \"free\",\n  \"reconnect\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/stream",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "stream"]
            }
          }
        }
      ]
    },
    {
      "name": "限流与安全测试",
      "item": [
        {
          "name": "快速请求测试（触发限流）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var status = pm.response.code;",
                  "if (status === 429) {",
                  "  console.log('⚠️ 已触发限流：' + pm.response.text());",
                  "} else if (status === 200) {",
                  "  console.log('✅ 请求成功');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/userinfo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "userinfo"]
            }
          }
        },
        {
          "name": "异地登录测试（设备A）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('设备A登录成功，记录token和deviceId');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Id", "value": "device-a-test-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"Test@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "异地登录测试（设备B - 踢掉设备A）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('设备B登录成功，设备A应被踢下线');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Id", "value": "device-b-test-002" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"Test@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "用户API Key(第三方)",
      "item": [
        {
          "name": "添加第三方API Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"deepseek\",\n  \"displayName\": \"我的DeepSeek\",\n  \"apiKey\": \"sk-xxx\",\n  \"baseUrl\": \"https://api.deepseek.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "api-keys"]
            }
          }
        },
        {
          "name": "查看第三方API Key列表",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Token", "value": "{{token}}" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "api-keys"]
            }
          }
        }
      ]
    }
  ]
}