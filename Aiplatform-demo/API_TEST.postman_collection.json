{
  "info": {
    "name": "AI Gateway Platform API",
    "description": "凌点AI模型调度网关接口测试 - 使用 X-User-Token Header 认证",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "value",
        "value": "{{token}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "X-User-Token",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "用户认证",
      "item": [
        {
          "name": "用户注册",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.code === 200) console.log('注册成功, userId=' + json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"Test@123456\",\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.code === 200 && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  console.log('登录成功, token已保存');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"Test@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "查询用户信息",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/userinfo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "userinfo"]
            }
          }
        },
        {
          "name": "查询余额",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "balance"]
            }
          }
        },
        {
          "name": "刷新Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-User-Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh-token"]
            }
          }
        },
        {
          "name": "退出登录",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-User-Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "API Key管理",
      "item": [
        {
          "name": "生成API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.code === 200 && json.data.apiKey) {",
                  "  pm.collectionVariables.set('apiKey', json.data.apiKey);",
                  "  console.log('API Key已保存');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Token", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"我的API Key\",\n  \"rateLimit\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/api-key/generate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "generate"]
            }
          }
        },
        {
          "name": "查询API Key列表",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/api-key/list",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "list"]
            }
          }
        },
        {
          "name": "启用API Key",
          "request": {
            "method": "PUT",
            "header": [{ "key": "X-User-Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/api-key/1/enable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "1", "enable"]
            }
          }
        },
        {
          "name": "禁用API Key",
          "request": {
            "method": "PUT",
            "header": [{ "key": "X-User-Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/api-key/1/disable",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "1", "disable"]
            }
          }
        },
        {
          "name": "更新限流阈值",
          "request": {
            "method": "PUT",
            "header": [{ "key": "X-User-Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/api-key/1/rate-limit?rateLimit=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "1", "rate-limit"],
              "query": [{ "key": "rateLimit", "value": "200" }]
            }
          }
        },
        {
          "name": "删除API Key",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-User-Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/api-key/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api-key", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "模型配置",
      "item": [
        {
          "name": "模型列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/model-config/list",
              "host": ["{{baseUrl}}"],
              "path": ["api", "model-config", "list"]
            }
          }
        }
      ]
    },
    {
      "name": "聊天对话",
      "item": [
        {
          "name": "免费模式 - 非流式对话",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-User-Token", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"deepseek-v4-flash\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"你好，请介绍一下你自己\"\n  }],\n  \"mode\": \"free\",\n  \"temperature\": 0.7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "completions"]
            }
          }
        },
        {
          "name": "免费模式 - 流式对话(SSE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-User-Token", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"deepseek-v4-flash\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"写一首关于春天的诗\"\n  }],\n  \"stream\": true,\n  \"mode\": \"free\",\n  \"temperature\": 0.8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/stream",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "stream"]
            }
          }
        },
        {
          "name": "自定义模型 - 非流式对话",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" },
              { "key": "X-User-Token", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"deepseek-chat\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"你好\"\n  }],\n  \"mode\": \"custom\",\n  \"userApiKeyId\": 1,\n  \"temperature\": 0.7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "chat", "completions"]
            }
          }
        }
      ]
    },
    {
      "name": "用户API Key(第三方)",
      "item": [
        {
          "name": "添加第三方API Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Token", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"deepseek\",\n  \"displayName\": \"我的DeepSeek\",\n  \"apiKey\": \"sk-xxx\",\n  \"baseUrl\": \"https://api.deepseek.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "api-keys"]
            }
          }
        },
        {
          "name": "查看第三方API Key列表",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Token", "value": "{{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/user/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "api-keys"]
            }
          }
        }
      ]
    }
  ]
}