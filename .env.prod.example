# ============================================================
# 凌点 AI 平台 - 线上服务器环境变量模板
# 用法: cp .env.prod.example .env.prod, 修改后用于生产部署
# 部署请使用 scripts/server-deploy.sh（先验收本地功能和服务器 Compose）
# ============================================================

# ---- MySQL (务必修改密码) ----
MYSQL_DATABASE=ai_gateway
MYSQL_PASSWORD=ChangeMe_Strong_Pwd_2026

# ---- Redis (生产环境必须设置；上线启用认证时需重启现有 Redis 容器) ----
REDIS_PASSWORD=replace_with_managed_redis_password

# ---- AI 模型 API ----
OPENAI_API_KEY=sk-your-real-api-key
DEEPSEEK_API_KEY=

# ---- API 加密密钥 (AES-256 Base64, 生产环境务必更换) ----
API_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_secret

# ---- CORS 允许的域名(生产环境建议指定具体域名, 多个逗号分隔) ----
ALLOWED_ORIGINS=https://your-domain.com

# ---- 端口映射 ----
BACKEND_PORT=8080
FRONTEND_PORT=80

# ---- JVM 参数 ----
JAVA_OPTS=-Xms256m -Xmx512m

# ---- 系统控制二级密码 (管理员容器启停功能) ----
SECONDARY_PASSWORD=replace_with_managed_secret

# ---- RabbitMQ 外部服务（未配置前保持关闭；不在本项目中创建新容器） ----
RABBITMQ_ENABLED=false
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# ---- 阿里云 OSS（留空时继续使用服务器本地持久化存储） ----
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_DOMAIN=
APP_STORAGE_PREFER_LOCAL=true

# ---- 阿里云邮件推送（SMTP 密码只配置在服务器 .env.prod，不要提交到 Git） ----
SPRING_MAIL_HOST=smtpdm.aliyun.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=noreply@notify.lingdian-ai.top
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
VERIFICATION_EMAIL_FROM=noreply@notify.lingdian-ai.top

# ---- 短信验证码（按网关协议配置 HTTPS 地址、Token 和模板） ----
VERIFICATION_DELIVERY_MODE=external
VERIFICATION_ALLOW_LOCAL_CAPTURE=false
REGISTRATION_EMAIL_VERIFICATION_REQUIRED=true
VERIFICATION_SMS_URL=
VERIFICATION_SMS_TOKEN=
VERIFICATION_SMS_TEMPLATE_ID=

# ---- Google OIDC 生产 Web 客户端（须使用正式 HTTPS 回调） ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ---- QQ 互联网站应用（可在审核中配置和联调；AppKey 只放受控配置，不要提交到 Git）----
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_KEY=
QQ_OAUTH_REDIRECT_URI=https://lingdian-ai.top/oauth/callback
QQ_OAUTH_REVIEW_STATUS=pending
