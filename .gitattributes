* text=auto

*.sh text eol=lf
*.py text eol=lf
*.java text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Unified patches can need trailing whitespace to match upstream files exactly.
*.patch whitespace=-blank-at-eol

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.jar binary
*.war binary
*.zip binary
*.rdb binary
